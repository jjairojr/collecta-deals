# Copie para /Users/Shared/collecta-bot/publicar/anuncios.env (chmod 600) e preencha. Nunca faça commit do arquivo preenchido.
OPDEALS_ADMIN_TOKEN=
NTFY_TOPIC=
META_TOKEN=
META_CONTA=act_
META_PAGINA=
META_INSTAGRAM_ID=
META_INSTAGRAM_USUARIO=tcgcollecta
META_PIXEL=959341777245828
META_VERSAO=v27.0
META_REELS_TESTE=on
META_CLOUDFLARED=/opt/homebrew/bin/cloudflared

# Anúncio de mensagens (Click to WhatsApp): número do WhatsApp da loja com DDI e DDD, só dígitos.
# Opcional: sem ele, o Meta usa o número ligado à Página.
META_WHATSAPP=

# Públicos personalizados do Meta (ids separados por vírgula). Sem o id, o público
# correspondente é recusado na propor_teste e nada é criado.
# remarketing: quem visitou o site, pôs no carrinho ou interagiu com o Instagram.
META_PUBLICO_REMARKETING=
# compradores: fica de fora do remarketing e do semelhante, e é o público "clientes".
META_PUBLICO_COMPRADORES=
# semelhante: público semelhante (lookalike) aos compradores, no Brasil.
META_PUBLICO_SEMELHANTE=
