{
  "model": "sonnet",
  "claudeMdExcludes": ["/Users/jjairo/.claude/CLAUDE.md"],
  "disableClaudeAiConnectors": true,
  "autoMemoryEnabled": false,
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": false,
    "gopls-lsp@claude-plugins-official": false,
    "frontend-design@claude-plugins-official": false,
    "code-review@claude-plugins-official": false,
    "claude-hud@claude-hud": false,
    "caveman@caveman": false,
    "mattpocock-skills@claude-plugins-official": false,
    "vercel@claude-plugins-official": false
  },
  "permissions": {
    "blockReadsOutsideWorkingDirectories": true,
    "blockWritesOutsideWorkingDirectories": true,
    "deny": [
      "Bash",
      "Read",
      "Write",
      "Edit",
      "MultiEdit",
      "Glob",
      "Grep",
      "LS",
      "WebFetch",
      "WebSearch",
      "NotebookEdit",
      "Agent",
      "Task",
      "Skill",
      "mcp__claude_ai_*"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/Shared/collecta-bot/guard.sh"
          }
        ]
      }
    ]
  }
}
