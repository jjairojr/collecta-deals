<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.collecta.atendente-vigia</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/Shared/collecta-bot/atendente-vigia</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>60</integer>

    <key>StandardOutPath</key>
    <string>__HOME__/.collecta-atendente/vigia.log</string>

    <key>StandardErrorPath</key>
    <string>__HOME__/.collecta-atendente/vigia.log</string>
</dict>
</plist>
