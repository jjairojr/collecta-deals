# Vigia do atendente. Copiado para ~/.collecta-atendente/vigia.env pelo make atendente (chmod 600).
# Mesmo valor de POSTSALE_AGENT_TOKEN do painel MCP do OpenBot (servidor collecta-loja).
POSTSALE_AGENT_TOKEN=
# Mesmo tópico do ntfy do atendente. Sem ele o vigia só escreve no log.
NTFY_TOPIC=
# Opcionais (padrões entre parênteses):
# VIGIA_BATIMENTO=20m        rodada sem pós-venda pendente (20m)
# VIGIA_ABERTAS=5m           com conversa de pós-venda aberta (5m)
# VIGIA_INTERVALO_MINIMO=3m  nunca acorda antes disso desde a última rodada (3m)
# VIGIA_HORARIO=8-22         das 8h até antes das 22h (8-22)
